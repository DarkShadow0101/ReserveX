# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (used by Prisma)
DATABASE_URL="postgresql://reservex:reservex_secret@localhost:5432/reservex_dev?schema=public"

# JWT Authentication
# In production, use a strong, high-entropy secret string
JWT_SECRET="reservex-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (Vite default dev server is 5173)
CORS_ORIGIN="http://localhost:5173"
