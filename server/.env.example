# ReserveX Environment Variables
# Server-level .env.example

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
MONGO_URI="mongodb+srv://<username>:<password>@/reservex?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="reservex-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Booking Inventory Holds
HOLD_TTL_MINUTES=10

# QR Ticket Security (Milestone 5)
QR_SIGNING_SECRET="reservex-qr-signing-key-change-in-production"

# Razorpay Payment Gateway (Test Mode - Milestone 4)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
